{
  "name": "ManagedServiceAccount",
  "kind": "ManagedServiceAccount",
  "apiVersion": "authentication.open-cluster-management.io/v1beta1",
  "description": "ManagedServiceAccount provides a mechanism to create and manage ServiceAccounts on managed clusters with automatic token rotation and expiration control.",
  "categories": ["Authentication", "OCM", "ServiceAccount", "Security"],
  "labels": ["ocm", "managed-service-account", "msa"],
  "usageHint": "Use this resource to automatically provision and manage service accounts across managed clusters with optional TTL and credential rotation policies.",
  "schema": {
    "spec": {
      "rotation": {
        "enabled": "boolean (deprecated)",
        "validity": "string (e.g., '8640h')"
      },
      "ttlSecondsAfterCreation": "integer (optional, time-to-live in seconds)"
    },
    "status": {
      "conditions": [
        {
          "type": "string",
          "status": "True | False | Unknown",
          "reason": "string",
          "message": "string",
          "lastTransitionTime": "date-time",
          "observedGeneration": "int64 (optional)"
        }
      ],
      "expirationTimestamp": "date-time",
      "tokenSecretRef": {
        "name": "string",
        "lastRefreshTimestamp": "date-time"
      }
    }
  }
}
